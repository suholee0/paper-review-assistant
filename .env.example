# Web chat/export uses the local Codex SDK and OS user's Codex authentication.
# Authenticate with: npx --no-install codex login
# CODEX_MODEL=your-available-model-id
# CODEX_PATH=/absolute/path/to/codex

# Next.js loads .env.local; standalone scripts use exported shell variables.
# Set the viewer port in the shell: PORT=3001 npm run paper:serve
